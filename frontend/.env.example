# Backend API Base URL (in production, your Render backend URL, e.g. https://your-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend Deployment URL (in production on Vercel, e.g. https://your-app.vercel.app)
# Used for Google OAuth callback redirect URI resolution.
# If omitted, LevelUp AI dynamically derives origin from window.location.origin in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support / Contact email address for 'Contact Us' mailto links
NEXT_PUBLIC_CONTACT_EMAIL=ankuromshukla161@gmail.com

