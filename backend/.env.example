# =====================================================================
# LevelUp AI - Backend Environment Configuration (.env.example)
# Copy this file to .env and provide your actual secrets/credentials.
# Do NOT commit .env into source control.
# =====================================================================

# ---------------------------------------------------------------------
# Database Connection (PostgreSQL)
# ---------------------------------------------------------------------
# Standard PostgreSQL URL format:
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
#
# Examples:
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/lifetrack
#
# Hosted Cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS, Render, Railway):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/lifetrack?sslmode=require
#
# SQLite fallback (for offline local development only):
# DATABASE_URL=sqlite:///./lifetrack.db

# ---------------------------------------------------------------------
# PostgreSQL Connection Pool Configuration
# ---------------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------
# JWT Authentication & Security
# ---------------------------------------------------------------------
# Generate a secure 32+ character random secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Backend-only secrets)
# ---------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production: Set FRONTEND_URL to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional explicit redirect URI. If left blank, the backend dynamically uses:
# ${FRONTEND_URL}/auth/callback/google (and accepts authorized origins passed by frontend)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ---------------------------------------------------------------------
# AI Service Providers & Fallback Chain
# ---------------------------------------------------------------------
# Primary provider to use: 'openai', 'gemini', 'groq', or 'mock'
AI_PROVIDER=openai

# Optional comma-separated list of fallback providers attempted sequentially
# upon transient failures (429, 502, 503, 504). Example: 'gemini,groq'
AI_FALLBACK_PROVIDERS=gemini,groq

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Google Gemini Configuration (Official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration (Official groq SDK)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# Application Environment
# ---------------------------------------------------------------------
ENVIRONMENT=development
