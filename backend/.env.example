# Database
DATABASE_URL=sqlite:///./lifetrack.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/lifetrack

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (optional - uses mock service if not set)
AI_API_KEY=
AI_PROVIDER=mock
